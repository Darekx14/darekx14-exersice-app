{
  "name": "darekx14-pushup-app",
  "version": "1.0.0",
  "description": "Darekx14 Exercising App — daily push-up circuit trainer with Discord Rich Presence",
  "main": "main.js",
  "author": "Darekx14",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4"
  },
  "build": {
    "appId": "com.darekx14.pushupapp",
    "productName": "Darekx14 Exercising App",
    "files": [
      "main.js",
      "renderer/**/*"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "executableName": "darekx14-pushup-app"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
